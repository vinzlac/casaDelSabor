# Justfile pour l'agent RAG Casa del Sabor

# Variables
default_port := "8000"
python := "uv run python"

# Affiche l'aide
default:
    @just --list

# ============================================
# 🚀 Installation
# ============================================

# Installe les dépendances
install:
    uv sync

# Installe les dépendances de dev
install-dev:
    uv sync --dev

# ============================================
# 🎯 Développement
# ============================================

# Lance le serveur en mode développement (accessible sur le réseau local)
dev port=default_port:
    uv run uvicorn main:app --reload --host 0.0.0.0 --port {{port}}

# Lance le serveur en mode production
run port=default_port:
    uv run uvicorn main:app --host 0.0.0.0 --port {{port}}

# Lance le serveur avec python
start:
    uv run python main.py

# ============================================
# 📚 RAG / Documents
# ============================================

# Indexe les documents dans Qdrant
# Note: L'API_KEY est chargée automatiquement depuis .env.local ou .env par l'application
ingest:
    ./scripts/ingest.sh {{default_port}}

# Force la réindexation des documents
reindex:
    ./scripts/reindex.sh {{default_port}}

# Vérifie si l'agent est en ligne (recommandé)
check env="local":
    ./scripts/check-agent.sh {{default_port}} {{env}}

# Vérifie le statut de l'agent (détaillé, nécessite agent en ligne)
status:
    ./scripts/status.sh {{default_port}}

# Health check simple
health:
    curl -s http://localhost:{{default_port}}/health | {{python}} -m json.tool --no-ensure-ascii

# Statut détaillé de l'agent (via script)
agent-status:
    ./scripts/agent-status.sh

# Health check uniquement
agent-health:
    ./scripts/agent-status.sh --health

# Statut complet
agent-status-full:
    ./scripts/agent-status.sh --status

# Test une question au chatbot (sans mémoire)
chat message:
    ./scripts/chat.sh {{default_port}} "{{message}}"

# Conversation interactive avec mémoire
conversation:
    {{python}} scripts/conversation.py

# ============================================
# 🧪 Tests
# ============================================

# Lance les tests
test:
    uv run pytest

# Lance les tests avec couverture
test-cov:
    uv run pytest --cov=. --cov-report=html

# ============================================
# 🔧 Utilitaires
# ============================================

# Formate le code
fmt:
    uv run ruff format .

# Vérifie le linting
lint:
    uv run ruff check .

# Corrige les erreurs de linting
lint-fix:
    uv run ruff check . --fix

# Nettoie les fichiers cache
clean:
    rm -rf __pycache__ .pytest_cache .ruff_cache .coverage htmlcov
    find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true

# ============================================
# 🐳 Docker (optionnel)
# ============================================

# Build l'image Docker
docker-build:
    docker build -t casa-del-sabor-agent .

# Lance le container Docker
docker-run:
    docker run -p 8000:8000 --env-file .env casa-del-sabor-agent

# ============================================
# 🗄️ Qdrant Local (Docker)
# ============================================

# Démarre Qdrant en local avec Docker
qdrant-up:
    docker-compose -f ../docker-compose.yml up -d qdrant
    @echo "✅ Qdrant démarré sur http://localhost:6333"
    @echo "📊 Dashboard: http://localhost:6333/dashboard"

# Arrête Qdrant local
qdrant-down:
    docker-compose -f ../docker-compose.yml down

# Affiche les logs de Qdrant
qdrant-logs:
    docker-compose -f ../docker-compose.yml logs -f qdrant

# Vérifie le statut de Qdrant (health check simple)
qdrant-status:
    curl -s http://localhost:6333/health | {{python}} -m json.tool

# Statut détaillé de Qdrant (local ou prod)
qdrant-info env="local":
    {{python}} scripts/qdrant_status.py --env {{env}}

# Statut complet de Qdrant (toutes les infos)
qdrant-info-all env="local":
    {{python}} scripts/qdrant_status.py --env {{env}} --all

# Collections Qdrant
qdrant-collections env="local":
    {{python}} scripts/qdrant_status.py --env {{env}} --collections

# Détails d'une collection spécifique
qdrant-collection name env="local":
    {{python}} scripts/qdrant_status.py --env {{env}} --collection {{name}}

# Nettoie les données Qdrant (supprime le volume)
qdrant-clean:
    docker-compose -f ../docker-compose.yml down -v
    @echo "⚠️  Toutes les données Qdrant ont été supprimées"
