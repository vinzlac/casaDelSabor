# Deployment exemple — image = ghcr.io/<owner>/<repo> après CI (Phase B).
# Copier vers deployment.yaml réel ou laisser Argo/homelab gérer la variante prod.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: casadelsabor-agent
  namespace: default
  labels:
    app: casadelsabor-agent
spec:
  replicas: 1
  selector:
    matchLabels:
      app: casadelsabor-agent
  template:
    metadata:
      labels:
        app: casadelsabor-agent
    spec:
      # imagePullSecrets:
      #   - name: ghcr-pull
      containers:
        - name: agent
          image: ghcr.io/OWNER/casadelsabor:latest
          ports:
            - containerPort: 8000
              name: http
          env:
            - name: LLM_API_KEY
              valueFrom:
                secretKeyRef:
                  name: casadelsabor-llm
                  key: LLM_API_KEY
            - name: QDRANT_API_KEY
              valueFrom:
                secretKeyRef:
                  name: casadelsabor-qdrant
                  key: QDRANT_API_KEY
                  optional: true
            - name: API_KEY
              valueFrom:
                secretKeyRef:
                  name: casadelsabor-api
                  key: API_KEY
                  optional: true
          envFrom:
            - configMapRef:
                name: casadelsabor-config
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 15
            periodSeconds: 20
