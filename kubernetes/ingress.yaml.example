# Traefik (web / websecure) — domaine homelab typique.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: casadelsabor-agent
  namespace: default
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: web,websecure
spec:
  rules:
    - host: casadelsabor-api.example.homelab
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: casadelsabor-agent
                port:
                  number: 8000
