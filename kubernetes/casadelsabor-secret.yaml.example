# Gabarits locaux (NE PAS committer de vraies valeurs). En prod : Sealed Secrets séparés.
#
# casadelsabor-llm.sealed.yaml   ← LLM_API_KEY
# kubectl create secret generic casadelsabor-llm --dry-run=client -n casadelsabor \
#   --from-literal=LLM_API_KEY=REPLACE -o yaml | kubeseal -o yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: casadelsabor-llm
  namespace: casadelsabor
type: Opaque
stringData:
  LLM_API_KEY: "REPLACE_ME"
---
# casadelsabor-qdrant.sealed.yaml ← QDRANT_API_KEY
# kubectl create secret generic casadelsabor-qdrant --dry-run=client -n casadelsabor \
#   --from-literal=QDRANT_API_KEY= -o yaml | kubeseal -o yaml
apiVersion: v1
kind: Secret
metadata:
  name: casadelsabor-qdrant
  namespace: casadelsabor
type: Opaque
stringData:
  QDRANT_API_KEY: ""
---
# casadelsabor-api.sealed.yaml ← API_KEY
# kubectl create secret generic casadelsabor-api --dry-run=client -n casadelsabor \
#   --from-literal=API_KEY=REPLACE -o yaml | kubeseal -o yaml
apiVersion: v1
kind: Secret
metadata:
  name: casadelsabor-api
  namespace: casadelsabor
type: Opaque
stringData:
  API_KEY: "REPLACE_ME_INGEST"
