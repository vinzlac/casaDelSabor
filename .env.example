# Gabarit « mémoire » prod — non chargé par l’application.
# Recopier les valeurs dans Railway / k8s.
# LLM_BASE_URL = même origine que pour curl …/v1/chat/completions (sans /chat/completions dans la variable).
#
# LLM_API_KEY : via LiteLLM (proxy), utiliser la Virtual Key du tableau de bord LiteLLM
# (préfixe sk-…). Une ancienne clé API Mistral « brute » ne convient pas si le proxy
# exige les clés virtuelles. MISTRAL_API_KEY est un alias de LLM_API_KEY : ne pas
# laisser les deux lignes avec des valeurs différentes — préférer uniquement LLM_API_KEY.

LLM_BASE_URL=https://llm.code-advisors.site/v1
LLM_API_KEY=sk-your_litellm_virtual_key_here
# Doit exister dans GET …/v1/models de ton LiteLLM (homelab actuel : mistral/mistral-tiny).
LLM_MODEL=mistral/mistral-tiny
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

EMBEDDING_MODEL=mistral/mistral-embed

QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=casa_del_sabor

AGENT_HOST=0.0.0.0
AGENT_PORT=8000
# Optionnel (dev) : AGENT_DEBUG=true pour voir l’exception réelle dans les erreurs /chat
API_KEY=your_ingest_secret
